APNS_KEY_ID=
APNS_TEAM_ID=
FCM_SERVICE_ACCOUNT_JSON=
APP_STORE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Optional JSON array. See docs/env.md for the full shape.
BILLING_VERIFICATION_ENABLED=false
BILLING_PRODUCTS_JSON=
